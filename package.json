{
  "name": "veylora-invoice-intelligence",
  "version": "1.0.0-demo.1",
  "description": "Demo auditable for AI-assisted invoice integrity and e-invoicing reconciliation.",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests/invoice-engine.test.mjs",
    "test:render": "vinext build && node --test tests/rendered-html.test.mjs",
    "test": "node --test tests/invoice-engine.test.mjs && vinext build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "verify:demo": "node scripts/verify-demo.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm verify:demo",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.49.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.32",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "0.2.1",
    "vite": "8.2.0",
    "wrangler": "4.116.0"
  },
  "type": "module",
  "license": "MIT",
  "pnpm": {
    "overrides": {
      "sharp": "0.35.3",
      "postcss": "8.5.18",
      "@esbuild-kit/core-utils>esbuild": "0.25.12"
    }
  }
}
